{
  "name": "bb-plugin-inbox",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.189"
  },
  "bb": {
    "name": "Inbox",
    "description": "One place for everything that waits on you. Mirrors decision cards from every thread, gives agents an inbox_ask tool, detects asks in final replies with an optional OpenAI key, and pings once per new item. Answers go back to the source thread. Adds `bb inbox list|ask|close`.",
    "branding": {
      "icon": "Inbox"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.189",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.12"
  },
  "description": "An inbox of the items that wait on you: decision cards, agent asks, and detected asks from every bb thread, in the left rail with a badge.",
  "license": "MIT",
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  }
}
