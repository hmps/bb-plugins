{
  "name": "bb-plugin-t3sidebar",
  "version": "1.0.0",
  "type": "module",
  "description": "An inbox-style sidebar with touch support: one flat list of cards that never re-orders.",
  "engines": {
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.6"
  },
  "bb": {
    "name": "t3sidebar",
    "description": "An inbox-style sidebar with touch support: one flat list of cards that never re-orders.",
    "branding": {
      "icon": "PanelLeft"
    },
    "app": "./app.tsx",
    "server": "./src/server.ts"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.6",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "12.10.0",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-select": "^2.3.3"
  }
}
