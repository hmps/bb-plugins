{
  "name": "bb-plugin-usage-tracker",
  "version": "1.0.0",
  "description": "Compact Codex and Claude usage limits in bb's sidebar footer, with model-scoped (Fable) quota rows.",
  "license": "MIT",
  "author": "Mateo Cerquetella",
  "homepage": "https://github.com/hmps/bb-plugins/tree/main/plugins/usage-tracker#readme",
  "bugs": {
    "url": "https://github.com/hmps/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmps/bb-plugins.git",
    "directory": "plugins/usage-tracker"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "agents",
    "usage",
    "quota",
    "codex",
    "claude-code",
    "cursor"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.6"
  },
  "bb": {
    "name": "Usage Tracker",
    "description": "Compact Codex and Claude usage limits in the sidebar footer, with model-scoped (Fable) quota rows.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "assets/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server.ts",
    "app.tsx",
    "app.css",
    "lib/",
    "types/",
    "tsconfig.json"
  ],
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "^0.38.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "bb plugin build .",
    "dev": "bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "contributors": [
    "Hampus Persson"
